<?xml version="1.0"?>
<ruleset name="Mail Vitals">
	<description>Coding standard for the Mail Vitals plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Class files are named after the class (PSR-4), not WordPress style,
		     because the plugin autoloads by namespace. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mail-vitals"/>
			</property>
		</properties>
	</rule>
</ruleset>
